# MongoDB Atlas connection string (Phase 3+)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/teen-patti-club?retryWrites=true&w=majority
# Allowed origin for CORS and Socket.io (the Vercel URL in production)
CLIENT_ORIGIN=http://localhost:5317
PORT=4000
NODE_ENV=development
# "Your turn" web push. Generate once with: npx web-push generate-vapid-keys
# (Optional in development: throwaway keys are used. Required in production for notifications.)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
