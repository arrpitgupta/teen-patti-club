{
  "name": "teen-patti-club",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @tpc/server --filter @tpc/client dev",
    "build": "pnpm -r build",
